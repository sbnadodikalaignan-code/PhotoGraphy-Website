# ==============================================================================
# Cloudflare Pages / Static Assets Caching Configuration
# ==============================================================================

# 1. Hashed Vite static assets (immutable for 1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Static public media, fonts, webp, and svg assets (30 days cache)
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 3. HTML pages must always revalidate immediately to deliver updates on deploy
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# 4. Global security & mime headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

